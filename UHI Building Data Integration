    "        cols = [col for col in df.columns if col != target_col] + [target_col]\n",
    "        return df[cols]\n",
    "    else:\n",
    "        print(f\"Warning: '{target_col}' not found in DataFrame.\")\n",
    "        return df\n",
    "\n",
