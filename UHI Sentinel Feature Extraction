    "# STEP 3: EXTRACT SENTINEL-2 FEATURES\n",
    "def extract_sentinel2_features(scene, building_gdf_utm, buffer_radius=200):\n",
    "    \"\"\"Extract all Tier 1 & Tier 2 Sentinel-2 features\"\"\"\n",
    "    import psutil\n",
    "    from rasterstats import zonal_stats\n",
