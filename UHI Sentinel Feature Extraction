    "    max_distance=1000\n",
    ")\n",
    "\n",
    "print(f\"✓ Train joined: {train_joined.shape}\")\n",
    "print(f\"✓ Test joined: {test_joined.shape}\")\n",
    "\n",
    "# STEP 6: ANALYZE & FILTER BY DISTANCE\n",
    "print(\"\\nAnalyzing match distances...\")\n",
    "\n",
    "# Check how many matches we have\n",
    "train_matched = train_joined['distance_meters'].notna().sum()\n",
