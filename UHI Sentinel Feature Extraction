    "coords = sentinel_data['building_key'].str.split('_', expand=True)\n",
    "sentinel_data['latitude'] = pd.to_numeric(coords[0], errors='coerce')\n",
    "sentinel_data['longitude'] = pd.to_numeric(coords[1], errors='coerce')\n",
    "\n",
    "# Remove rows with invalid coordinates\n",
    "valid_coords = sentinel_data['latitude'].notna() & sentinel_data['longitude'].notna()\n",
    "sentinel_data = sentinel_data[valid_coords].copy()\n",
    "\n",
    "# Create GeoDataFrame\n",
    "sentinel_gdf = gpd.GeoDataFrame(\n",
    "    sentinel_data,\n",
    "    geometry=gpd.points_from_xy(sentinel_data['longitude'], sentinel_data['latitude']),\n",
    "    crs=\"EPSG:4326\"\n",
    ")\n",
    "\n",
    "# Keep only needed columns\n",
    "keep_cols = ['geometry'] + [f for f in sentinel_features if f in sentinel_gdf.columns]\n",
    "sentinel_gdf = sentinel_gdf[keep_cols]\n",
    "\n",
    "print(f\"✓ Sentinel data: {len(sentinel_gdf)} points, {len(keep_cols)-1} features\")\n",
    "\n",
    "# STEP 3: PREPARE TRAIN/TEST DATA\n",
    "print(\"\\nPreparing train/test data...\")\n",
    "\n",
    "# Create train GeoDataFrame\n",
    "train_gdf = gpd.GeoDataFrame(\n",
    "    train,\n",
    "    geometry=gpd.points_from_xy(train['Longitude'], train['Latitude']),\n",
    "    crs=\"EPSG:4326\"\n",
    ")\n",
    "\n",
    "# Create test GeoDataFrame\n",
    "test_gdf = gpd.GeoDataFrame(\n",
    "    test,\n",
