    "\n",
    "print(f\"✓ Train data: {len(train_gdf)} points\")\n",
    "print(f\"✓ Test data: {len(test_gdf)} points\")\n",
    "\n",
    "# STEP 4: REPROJECT FOR ACCURATE DISTANCES\n",
    "print(\"\\nReprojecting for accurate distance calculation...\")\n",
    "\n",
    "# Find center point for UTM zone selection\n",
    "center_lon = train_gdf.geometry.x.mean()\n",
    "utm_zone = int((center_lon + 180) / 6) + 1\n",
    "center_lat = train_gdf.geometry.y.mean()\n",
    "hemisphere = '326' if center_lat >= 0 else '327'\n",
    "utm_crs = f\"EPSG:{hemisphere}{utm_zone:02d}\"\n",
    "\n",
    "# Reproject to UTM\n",
    "train_utm = train_gdf.to_crs(utm_crs)\n",
    "test_utm = test_gdf.to_crs(utm_crs)\n",
    "sentinel_utm = sentinel_gdf.to_crs(utm_crs)\n",
    "\n",
    "print(f\"✓ Using UTM zone: EPSG:{hemisphere}{utm_zone:02d}\")\n",
    "\n",
    "# STEP 5: PERFORM SPATIAL JOIN\n",
    "print(\"\\nPerforming spatial join...\")\n",
    "\n",
    "# Join train data\n",
    "train_joined = gpd.sjoin_nearest(\n",
    "    train_utm, \n",
