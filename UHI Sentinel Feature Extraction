    "# STEP 2: PREPARE BUILDING CENTROIDS\n",
    "def prepare_building_centroids(building_gdf):\n",
    "    \"\"\"Prepare building centroids in UTM with building_key\"\"\"\n",
    "    print(\"Preparing building centroids in UTM zone 18N...\")\n",
    "    \n",
    "    if building_gdf.crs is None:\n",
    "        building_gdf = building_gdf.set_crs(\"EPSG:4326\")\n",
    "    elif building_gdf.crs != \"EPSG:4326\":\n",
    "        building_gdf = building_gdf.to_crs(\"EPSG:4326\")\n",
    "    \n",
    "    if 'building_key' not in building_gdf.columns:\n",
    "        building_gdf['Latitude'] = building_gdf.geometry.centroid.y\n",
    "        building_gdf['Longitude'] = building_gdf.geometry.centroid.x\n",
    "        building_gdf['building_key'] = (\n",
    "            building_gdf['Latitude'].round(6).astype(str) + '_' +\n",
    "            building_gdf['Longitude'].round(6).astype(str)\n",
    "        )\n",
    "        print(\"Created 'building_key' from centroid coordinates.\")\n",
    "    \n",
    "    building_utm = building_gdf.to_crs(\"EPSG:32618\")\n",
    "    building_utm['centroid'] = building_utm.geometry.centroid\n",
    "    building_utm = building_utm[['building_key', 'centroid']].copy()\n",
    "    \n",
    "    print(f\"   Prepared {len(building_utm)} building centroids in UTM\")\n",
    "    return building_utm\n",
    "\n",
    "if 'building_gdf' not in globals():\n",
    "    raise ValueError(\"Building GeoDataFrame 'building_gdf' must be loaded.\")\n",
    "else:\n",
    "    building_utm = prepare_building_centroids(building_gdf)"
