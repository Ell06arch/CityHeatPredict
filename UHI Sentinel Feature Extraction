    "        'swir_1': 'B11',  # 1610nm\n",
    "        'swir_2': 'B12'   # 2190nm\n",
    "    }\n",
    "    \n",
    "    # Process bands\n",
    "    band_data = {}\n",
    "    for band_name, band_id in s2_bands.items():\n",
    "        print(f\"   Processing band: {band_name} ({band_id})\")\n",
    "        asset_href = scene.assets[band_id].href\n",
    "        \n",
    "        with rasterio.open(asset_href) as src:\n",
    "            transformer = Transformer.from_crs(\"EPSG:32618\", src.crs, always_xy=True)\n",
    "            bbox_proj = transformer.transform_bounds(\n",
    "                study_area_utm.bounds[0], study_area_utm.bounds[1],\n",
    "                study_area_utm.bounds[2], study_area_utm.bounds[3]\n",
    "            )\n",
    "            bbox_shapely = box(*bbox_proj)\n",
    "            out_image, out_transform = mask(src, [bbox_shapely], crop=True)\n",
    "            band_array = out_image[0]\n",
    "            band_data[band_name] = {\n",
    "                'data': band_array.astype(float) / 10000,  # Apply scale factor\n",
    "                'transform': out_transform,\n",
    "                'crs': src.crs\n",
    "            }\n",
    "        gc.collect()\n",
    "\n",
    "    # Resample 20m bands to 10m resolution to match B08\n",
    "    from scipy.ndimage import zoom\n",
    "    \n",
    "    def resample_to_10m(array_20m):\n",
    "        \"\"\"Resample 20m array to 10m resolution (2x zoom)\"\"\"\n",
    "        return zoom(array_20m, 2, order=1)\n",
    "    \n",
    "    # Apply resampling for 20m bands\n",
    "    for band_name in ['swir_1', 'swir_2']:\n",
    "        if band_name in band_data:\n",
    "            band_data[band_name]['data'] = resample_to_10m(band_data[band_name]['data'])\n",
    "            print(f\"     Resampled {band_name} from 20m to 10m resolution\")\n",
    "\n",
    "    # Helper function to trim arrays to common dimensions\n",
    "    def trim_to_common(*arrays):\n",
    "        \"\"\"Trim multiple arrays to their smallest common dimensions\"\"\"\n",
    "        min_rows = min(arr.shape[0] for arr in arrays)\n",
    "        min_cols = min(arr.shape[1] for arr in arrays)\n",
    "        return [arr[:min_rows, :min_cols] for arr in arrays]\n",
    "\n",
    "    # Compute derived indices\n",
    "    print(\"   Calculating indices...\")\n",
    "    \n",
    "    # 1. NDVI (Tier 2 feature)\n",
    "    if all(b in band_data for b in ['nir', 'red']):\n",
    "        nir = band_data['nir']['data']\n",
    "        red = band_data['red']['data']\n",
    "        ndvi = np.zeros_like(nir)\n",
    "        mask_valid = (nir + red) != 0\n",
    "        ndvi[mask_valid] = (nir[mask_valid] - red[mask_valid]) / (nir[mask_valid] + red[mask_valid])\n",
    "        band_data['ndvi'] = {\n",
    "            'data': ndvi,\n",
    "            'transform': band_data['nir']['transform'],\n",
    "            'crs': band_data['nir']['crs']\n",
    "        }\n",
    "        print(\"     ✓ Calculated NDVI (Tier 2: temporal alignment)\")\n",
    "    \n",
    "    # 2. REPI (Tier 1 feature)\n",
    "    if all(b in band_data for b in ['red_edge_1', 'red_edge_2', 'red_edge_3']):\n",
    "        b705 = band_data['red_edge_1']['data']\n",
    "        b740 = band_data['red_edge_2']['data']\n",
    "        b783 = band_data['red_edge_3']['data']\n",
    "        repi = np.zeros_like(b705)\n",
    "        mask_valid = (b705 > 0) & (b740 > 0) & (b783 > 0)\n",
    "        \n",
    "        # Standard REPI formula: wavelength at maximum slope between 705-783nm\n",
    "        if np.any(mask_valid):\n",
    "            slope_705_740 = (b740[mask_valid] - b705[mask_valid]) / (740 - 705)\n",
    "            slope_740_783 = (b783[mask_valid] - b740[mask_valid]) / (783 - 740)\n",
    "            max_slope_pos = np.where(slope_705_740 > slope_740_783, 725, 760)\n",
    "            repi[mask_valid] = max_slope_pos\n",
    "            \n",
    "        band_data['repi'] = {\n",
    "            'data': repi,\n",
    "            'transform': band_data['red_edge_1']['transform'],\n",
    "            'crs': band_data['red_edge_1']['crs']\n",
    "        }\n",
    "        print(\"     ✓ Calculated REPI (Tier 1: vegetation stress)\")\n",
    "    \n",
    "    # 3. NDMI (Tier 2 feature) - Correct formula\n",
    "    if all(b in band_data for b in ['nir', 'swir_1']):\n",
    "        # Requested formula: (B865 - B1610) / (B865 + B1610)\n",
    "        # B865 approximated by B08 (842nm), B1610 is B11\n",
    "        nir = band_data['nir']['data']  # B08 (842nm) approximates B865\n",
    "        swir1 = band_data['swir_1']['data']  # B11 (1610nm)\n",
    "        \n",
    "        # Trim to common dimensions\n",
    "        nir_trimmed, swir1_trimmed = trim_to_common(nir, swir1)\n",
    "        \n",
    "        ndmi = np.zeros_like(nir_trimmed)\n",
    "        mask_valid = (nir_trimmed + swir1_trimmed) != 0\n",
    "        ndmi[mask_valid] = (nir_trimmed[mask_valid] - swir1_trimmed[mask_valid]) / (nir_trimmed[mask_valid] + swir1_trimmed[mask_valid])\n",
    "        band_data['ndmi'] = {\n",
    "            'data': ndmi,\n",
    "            'transform': band_data['nir']['transform'],\n",
    "            'crs': band_data['nir']['crs']\n",
    "        }\n",
    "        print(\"     ✓ Calculated NDMI (Tier 2: vegetation moisture)\")\n",
    "    \n",
    "    # 4. BSMP Index (Tier 3 feature)\n",
    "    if all(b in band_data for b in ['swir_1', 'swir_2', 'nir', 'red']):\n",
    "        # Built Surface Material Property Index\n",
    "        # High values = heat-absorbing materials (asphalt), Low values = reflective (concrete)\n",
    "        swir1 = band_data['swir_1']['data']  # 1610nm\n",
    "        swir2 = band_data['swir_2']['data']  # 2190nm\n",
    "        nir = band_data['nir']['data']       # 842nm\n",
    "        red = band_data['red']['data']       # 665nm\n",
    "        \n",
    "        # Trim to common dimensions\n",
    "        swir1_trimmed, swir2_trimmed, nir_trimmed, red_trimmed = trim_to_common(swir1, swir2, nir, red)\n",
    "        \n",
    "        bsmpi = np.zeros_like(swir1_trimmed)\n",
    "        mask_valid = (swir1_trimmed + swir2_trimmed + nir_trimmed + red_trimmed) != 0\n",
    "        bsmpi[mask_valid] = (swir1_trimmed[mask_valid] + swir2_trimmed[mask_valid]) / (nir_trimmed[mask_valid] + red_trimmed[mask_valid])\n",
    "        \n",
    "        band_data['bsmpi'] = {\n",
    "            'data': bsmpi,\n",
    "            'transform': band_data['swir_1']['transform'],\n",
    "            'crs': band_data['swir_1']['crs']\n",
    "        }\n",
    "        print(\"     ✓ Calculated BSMP Index (Tier 3: material heat retention)\")\n",
    "    \n",
    "    # 5. Built Fraction (Tier 1 feature) - Improved calculation\n",
    "    if all(b in band_data for b in ['swir_1', 'nir']):\n",
    "        # More accurate built fraction using multiple bands\n",
    "        swir1 = band_data['swir_1']['data']  # 1610nm (built materials)\n",
    "        nir = band_data['nir']['data']       # 842nm (vegetation)\n",
    "        \n",
    "        # Trim to common dimensions\n",
    "        swir1_trimmed, nir_trimmed = trim_to_common(swir1, nir)\n",
    "        \n",
    "        # Built-up index range: -1 to 1, where higher values = more built-up\n",
    "        built_idx = np.zeros_like(swir1_trimmed)\n",
    "        mask_valid = (swir1_trimmed + nir_trimmed) != 0\n",
    "        built_idx[mask_valid] = (swir1_trimmed[mask_valid] - nir_trimmed[mask_valid]) / (swir1_trimmed[mask_valid] + nir_trimmed[mask_valid])\n",
    "        \n",
    "        # Convert to percentage (0-100%)\n",
    "        built_fraction = np.zeros_like(built_idx)\n",
    "        built_fraction[mask_valid] = ((built_idx[mask_valid] + 1) / 2) * 100\n",
    "        built_fraction = np.clip(built_fraction, 0, 100)  # Ensure 0-100 range\n",
    "        \n",
    "        band_data['built_fraction'] = {\n",
    "            'data': built_fraction,\n",
    "            'transform': band_data['swir_1']['transform'],\n",
    "            'crs': band_data['swir_1']['crs']\n",
    "        }\n",
    "        print(\"     ✓ Calculated Built Fraction (Tier 1: mixed pixel resolution)\")\n",
    "    \n",
    "    # Zonal statistics per building (200m buffers)\n",
    "    print(f\"\\nProcessing {len(building_gdf_utm)} buildings in batches...\")\n",
    "    BATCH_SIZE = 50\n",
    "    results = []\n",
    "\n",
    "    # Define features to extract (aligned with requested tiers)\n",
    "    requested_features = ['ndvi', 'repi', 'ndmi', 'bsmpi', 'built_fraction']\n",
    "    \n",
    "    for i in tqdm(range(0, len(building_gdf_utm), BATCH_SIZE)):\n",
    "        batch = building_gdf_utm.iloc[i:i+BATCH_SIZE]\n",
    "        batch_results = []\n",
    "        for _, row in batch.iterrows():\n",
    "            building_key = row['building_key']\n",
    "            buffer_geom = row['centroid'].buffer(buffer_radius)\n",
    "            feature_row = {'building_key': building_key}\n",
    "            \n",
    "            for feature_name in requested_features:\n",
    "                if feature_name in band_data:\n",
    "                    data = band_data[feature_name]['data']\n",
    "                    transform = band_data[feature_name]['transform']\n",
    "                    try:\n",
    "                        stats = zonal_stats(\n",
    "                            buffer_geom, data, affine=transform,\n",
    "                            stats=['mean', 'std', 'count'], nodata=0\n",
    "                        )[0]\n",
    "                        if stats['count'] > 0:\n",
    "                            feature_row[f'sentinel2_{feature_name}_mean_{buffer_radius}m'] = stats['mean']\n",
    "                            feature_row[f'sentinel2_{feature_name}_std_{buffer_radius}m'] = stats['std']\n",
    "                            feature_row[f'sentinel2_{feature_name}_valid_pixels_{buffer_radius}m'] = stats['count']\n",
    "                        else:\n",
    "                            feature_row[f'sentinel2_{feature_name}_mean_{buffer_radius}m'] = np.nan\n",
    "                            feature_row[f'sentinel2_{feature_name}_std_{buffer_radius}m'] = np.nan\n",
    "                            feature_row[f'sentinel2_{feature_name}_valid_pixels_{buffer_radius}m'] = 0\n",
    "                    except Exception as e:\n",
    "                        print(f\"     Error for {building_key}, {feature_name}: {e}\")\n",
    "                        feature_row[f'sentinel2_{feature_name}_mean_{buffer_radius}m'] = np.nan\n",
    "                        feature_row[f'sentinel2_{feature_name}_std_{buffer_radius}m'] = np.nan\n",
    "                        feature_row[f'sentinel2_{feature_name}_valid_pixels_{buffer_radius}m'] = 0\n",
    "            batch_results.append(feature_row)\n",
    "        results.extend(batch_results)\n",
    "        gc.collect()\n",
    "\n",
    "    s2_features = pd.DataFrame(results)\n",
    "    output_file = f\"sentinel2_features_{buffer_radius}m.parquet\"\n",
    "    s2_features.to_parquet(output_file)\n",
    "    print(f\"\\n Sentinel-2 extraction complete. Features saved to: {output_file}\")\n",
    "    return s2_features"
   ]
