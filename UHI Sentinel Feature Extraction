    "    print(f\"\\nExtracting Sentinel-2 features for {buffer_radius}m buffers...\")\n",
    "    \n",
    "    # Define BANDS needed for all requested indices\n",
    "    s2_bands = {\n",
    "        'blue': 'B02',    # 490nm\n",
    "        'green': 'B03',   # 560nm\n",
    "        'red': 'B04',     # 665nm\n",
    "        'red_edge_1': 'B05',  # 705nm\n",
