    "# STEP 1: FIND MULTIPLE SCENES \n",
    "def get_best_scene(collection_id, bbox, target_date=\"2021-07-24\", max_cloud_cover=20, date_range=\"2021-06-01/2021-09-01\"):\n",
    "    \"\"\"Get the scene closest to the target date\"\"\"\n",
    "    catalog = pystac_client.Client.open(\"https://planetarycomputer.microsoft.com/api/stac/v1\")\n",
    "    \n",
    "    search_params = {\n",
    "        \"collections\": [collection_id],\n",
    "        \"intersects\": bbox.__geo_interface__,\n",
    "        \"datetime\": date_range,\n",
    "        \"sortby\": [{\"field\": \"properties.datetime\", \"direction\": \"asc\"}]\n",
    "    }\n",
    "    \n",
    "    if collection_id == \"sentinel-2-l2a\":\n",
    "        search_params[\"query\"] = {\"eo:cloud_cover\": {\"lt\": max_cloud_cover}}\n",
    "    \n",
    "    search = catalog.search(**search_params)\n",
    "    scenes = list(search.get_items())\n",
    "    \n",
    "    if not scenes:\n",
    "        raise ValueError(f\"No scenes found for {collection_id} in date range {date_range}\")\n",
    "    \n",
    "    # Find scene closest to target date\n",
    "    target_dt = pd.to_datetime(target_date, utc=True)\n",
    "    best_scene = None\n",
    "    min_days_diff = float('inf')\n",
    "    \n",
    "    for scene in scenes:\n",
    "        scene_dt = pd.to_datetime(scene.datetime, utc=True)\n",
    "        days_diff = abs((scene_dt - target_dt).days)\n",
    "        \n",
    "        if days_diff < min_days_diff:\n",
    "            min_days_diff = days_diff\n",
    "            best_scene = scene\n",
    "    \n",
    "    # Calculate cloud cover if applicable\n",
    "    scene_info = {\n",
    "        'id': best_scene.id,\n",
    "        'datetime': pd.to_datetime(best_scene.datetime, utc=True),\n",
    "        'days_from_target': (pd.to_datetime(best_scene.datetime, utc=True) - target_dt).days\n",
    "    }\n",
    "    \n",
    "    if collection_id == \"sentinel-2-l2a\":\n",
    "        scene_info['cloud_cover'] = best_scene.properties.get('eo:cloud_cover', 100)\n",
    "    \n",
    "    return planetary_computer.sign(best_scene), scene_info\n",
    "\n",
    "# Main execution\n",
    "# Get best Sentinel-2 scene\n",
    "best_s2_scene, s2_scene_info = get_best_scene(\n",
    "    \"sentinel-2-l2a\", \n",
    "    study_area, \n",
    "    target_date=\"2021-07-24\", \n",
    "    max_cloud_cover=20,\n",
    "    date_range=\"2021-06-01/2021-09-01\"\n",
    ")\n",
